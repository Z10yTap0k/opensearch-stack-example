{
  "index_patterns": ["dev-app-server"],
  "priority": 300,
  "data_stream": {},
  "template": {
    "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "body": { "type": "match_only_text" },
        "traceId": { "type": "keyword" },
        "spanId": { "type": "keyword" },
        "severityText": { "type": "keyword" },
        "severityNumber": { "type": "short" },
        "time": { "type": "date_nanos" },
        "observedTimestamp": { "type": "date_nanos" },
        "instrumentationScope": { "properties": { "name": { "type": "keyword" } } },
        "resource": {
          "properties": {
            "attributes": {
              "properties": {
                "service": {
                  "properties": {
                    "name": { "type": "keyword" },
                    "version": { "type": "keyword" },
                    "instance": { "properties": { "id": { "type": "keyword" } } }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "_meta": { "tenant": "dev_team", "description": "OTLP logs from dev demo-server" }
}
