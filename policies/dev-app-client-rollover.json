{
  "policy": {
    "description": "Roll over dev-app-client data stream backing indices after 50 documents.",
    "default_state": "rollover",
    "states": [
      {
        "name": "rollover",
        "actions": [
          {
            "rollover": {
              "min_doc_count": 50
            }
          }
        ],
        "transitions": []
      }
    ],
    "ism_template": {
      "index_patterns": [
        "dev-app-client*"
      ],
      "priority": 100
    }
  }
}
