# Используем минималистичный и безопасный официальный образ Python
FROM python:3.11-slim

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Сначала копируем только файл зависимостей (для эффективного кэширования слоев Docker)
COPY requirements.txt .

# Устанавливаем зависимости без сохранения кэша pip (уменьшает размер образа)
RUN pip install --no-cache-dir -r requirements.txt

# Копируем остальной исходный код приложения
COPY main.py .

# Запуск приложения
CMD ["python", "main.py"]
